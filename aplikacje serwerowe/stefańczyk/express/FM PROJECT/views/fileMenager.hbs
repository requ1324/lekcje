<a href="/login">Login</a>
<a href="/logout">Logout</a>
<a href="/register">Register</a>
<a href="/error">Error</a>
<div class="header">
  <div class="header-content">
    <h1>{{title}}</h1>
    <div class="breadcrumb">
      <span class="breadcrumb-item">
        <span>🏠</span>
        {{#each root}}
          <a
            style="color:white;"
            href="/move?path=/{{this.path}}"
          >{{this.name}}</a>/

        {{/each}}
      </span>
    </div>
  </div>
  <div class="nav">
    <button class="btn btn-primary" id="newFolder">
      <span>📁</span>
      <span>Nowy folder</span>
    </button>
    <button class="btn btn-secondary" id="newFile">
      <span>📄</span>
      <span>Nowy plik</span>
    </button>
    <form action="/upload" method="get" style="display: inline-flex;">
      <label class="file-input-wrapper">
        <input type="file" multiple name="upload" id="fileUpload" />
        <button type="submit" class="btn btn-upload">
          <span>⬆️</span>
          <span>Prześlij pliki</span>
        </button>
      </label>
    </form>
  </div>
</div>
<div id="fileFormContainer" style="display:none">
  <form action="/addFile" method="post" class="fileForm">
    <input placeholder="type file name" type="text" name="fileName" />
    <select name="fileType" id="fileSelect">
      <option value="css">css</option>
      <option value="js">js</option>
      <option value="html">html</option>
      <option value="json">json</option>
    </select>
    <button type="submit">create file</button>
    <button type="button">cancel</button>
  </form>
</div>
<div class="container">

  <div class="item-list">
    {{#each folders}}
      <div class="item">
        <div class="item-content">
          <span class="item-icon">📁</span>
          <a href="/move?path=/{{this}}" class="item-name">{{this}}</a>
        </div>
        <button class="renameBtn">R</button>
        <form class="renameForm" method="post" action="/rename">
          <input type="hidden" name="folderName" value="{{this}}" />
          <input
            type="text"
            name="newFolderName"
            placeholder="podaj nową nazwę"
          />
          <button class="submit" type="submit">Rename</button>
          <button type="button" class="cancel">cancel</button>
        </form>
        <a href="/downloadFolder?name={{this}}" class="download-btn">D</a>
        <a href="/deleteFolder?name={{this}}" class="delete-btn">X</a>
      </div>
    {{else}}
      <div class="empty-state">
        <div class="empty-state-icon">📂</div>
        <div class="empty-state-text">Brak folderów</div>
      </div>
    {{/each}}
  </div>

  <div class="item-list">
    {{#each files}}
      <div class="item">
        <div class="item-content">
          <span class="item-icon">📄</span>
          <a class="item-name" href="/editor?name={{this}}">{{this}}</a>
        </div>
        <button class="renameBtn">R</button>
        <form class="renameForm" method="post" action="/rename">
          <input type="hidden" name="folderName" value="{{this}}" />
          <input
            type="text"
            name="newFolderName"
            placeholder="podaj nową nazwę"
          />
          <button class="submit" type="submit">Rename</button>
          <button type="button" class="cancel">cancel</button>
        </form>
        <a href="/downloadFile?name={{this}}" class="download-btn">D</a>
        <a href="/deleteFile?name={{this}}" class="delete-btn">X</a>
      </div>
    {{else}}
      <div class="empty-state">
        <div class="empty-state-icon">📄</div>
        <div class="empty-state-text">Brak plików</div>
      </div>
    {{/each}}

  </div>
</div>

<script>
  let isShow = false; const newFolderBtn = document.getElementById('newFolder');
  const newFileBtn = document.getElementById('newFile');
  newFolderBtn.addEventListener('click', () => { if (isShow) return; isShow =
  true; const div = document.createElement("div"); const form =
  document.createElement("form"); form.classList.add("folderForm"); form.method
  = "post"; form.action = "/addFolder"; div.appendChild(form); const input =
  document.createElement("input"); input.type = "text"; input.placeholder =
  "folder name"; input.name = 'folderName'; form.appendChild(input); const
  submit = document.createElement("button"); submit.type = "submit";
  submit.innerText = "create folder"; form.appendChild(submit); const cancel =
  document.createElement("button"); cancel.type = "button"; cancel.innerText =
  "cancel"; cancel.addEventListener('click', () => {
  document.body.removeChild(div); isShow = false; }); form.appendChild(cancel);
  document.body.appendChild(div); }); newFileBtn.addEventListener('click', () =>
  { const container = document.getElementById('fileFormContainer');
  container.style.display = "flex"; const cancelBtn =
  container.querySelector(".cancel"); cancelBtn.addEventListener("click", () =>
  { container.style.display = "none"; }); }); const renameBtns =
  document.querySelectorAll(".renameBtn"); renameBtns.forEach(renameBtn => {
  renameBtn.addEventListener('click', (e) => { const item =
  e.target.closest('.item'); const form = item.querySelector('.renameForm');
  form.style.display = "flex"; }); }); const cancelBtns =
  document.querySelectorAll('.cancel'); cancelBtns.forEach(btn => {
  btn.addEventListener("click", (e) => { const form =
  e.target.closest('.renameForm'); form.style.display = "none"; }); });
</script>